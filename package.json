{
  "name": "mygo-music-navidrome",
  "version": "0.1.0",
  "private": true,
  "description": "A Navidrome source plugin for MyGo Music with custom HTTP headers (Cloudflare Zero Trust service tokens) for the API, covers and audio",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/mygo-music-navidrome.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test \"test/*.test.mjs\"",
    "test:watch": "node scripts/build.mjs && node --test --watch \"test/*.test.mjs\"",
    "package": "node scripts/package.mjs",
    "package:release": "node scripts/package.mjs --release"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
